# Copia este archivo como ".env" (sin el ".example") y llena tus datos reales.
# NUNCA subas el archivo ".env" real a GitHub ni lo compartas.

# Llave secreta de Flask para las sesiones de login (invéntate un texto largo y random)
SECRET_KEY=cambia-esto-por-algo-largo-y-aleatorio

# Datos de conexión a Oracle Autonomous Database
DB_USER=APP_CAFEREAL
DB_PASSWORD=la-contraseña-del-usuario-APP_CAFEREAL
# El DSN es el alias que aparece en tnsnames.ora dentro del wallet, ej: cafejorge_high
DB_DSN=cafejorge_high

# Carpeta donde vas a descomprimir el wallet descargado de Oracle Cloud
WALLET_DIR=./wallet
# Solo si le pusiste contraseña al wallet al descargarlo (si no, déjalo vacío)
WALLET_PASSWORD=
